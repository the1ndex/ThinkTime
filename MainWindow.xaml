<Window x:Class="ThinkTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThinkTime"
        Title="ThinkTime" Width="1280" Height="720" MinWidth="960" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" Background="#070B10"
        WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Border BorderBrush="#2A3541" BorderThickness="1" Background="#070B10">
        <Grid>
            <local:WorldClockView x:Name="WorldView"/>

            <Border VerticalAlignment="Top" Height="72" Background="#E6080D13"
                    BorderBrush="#2A3541" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="28" Height="28" Margin="0,0,12,0">
                            <Ellipse Width="24" Height="24" Stroke="#50E2231A" StrokeThickness="1"/>
                            <Ellipse Width="9" Height="9" Fill="#E2231A"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="ThinkTime" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="HeaderSubtitle" Text="世界时钟系统  /  实时太阳模型" FontFamily="{StaticResource UiFont}"
                                       FontSize="11" FontWeight="Medium" Foreground="#7C8996" Margin="1,2,0,0"/>
                        </StackPanel>
                        <Border Margin="22,0,0,0" Padding="11,0" Height="36" VerticalAlignment="Center"
                                CornerRadius="11" Background="#101923" BorderBrush="#293542" BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Fill="#6EC99A" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OnlineText" Grid.Column="1" Text="在线" FontFamily="{StaticResource UiFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9CB4A8" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTime" Text="--:--" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="#71808D" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button x:Name="SettingsButton" Content="&#xE713;" Click="SettingsButton_Click"
                                Style="{StaticResource SettingsGearButton}" ToolTip="设置" Margin="0,0,6,0"/>
                        <Button x:Name="DesktopButton" Content="应用动态壁纸" Click="DesktopButton_Click"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                        <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource WindowButton}"/>
                        <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource WindowButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border VerticalAlignment="Bottom" Height="38" Margin="20,0,20,16" Background="#E0090E14"
                    BorderBrush="#303B47" BorderThickness="1" CornerRadius="5" Padding="12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="#6EC99A" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="实时  /  晨昏线  /  当地时间"
                                   FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Medium" Foreground="#8E9AA6"/>
                    </StackPanel>
                    <TextBlock x:Name="DataSourceText" Text="NASA 夜间灯光  /  NOAA 太阳模型" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="Medium" Foreground="#66727E"/>
                </Grid>
            </Border>

            <Border x:Name="SettingsPanel" Visibility="Collapsed" Opacity="0" Width="410"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,82,20,20"
                    Background="{StaticResource PanelBrush}" BorderBrush="#3A4653"
                    BorderThickness="1" CornerRadius="7" Padding="0" RenderTransformOrigin="1,.5">
                <Border.RenderTransform><TranslateTransform X="18"/></Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Background="#E2231A" CornerRadius="7,7,0,0"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="24,18,24,24">
                            <Grid Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock x:Name="SettingsTitleText" Text="设置与使用" FontFamily="{StaticResource UiFont}"
                                               FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="SettingsSubtitleText" Text="更改会自动保存并应用" FontFamily="{StaticResource UiFont}"
                                               FontSize="12" FontWeight="Medium" Foreground="#73808C" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="SettingsButton_Click" Style="{StaticResource WindowButton}"/>
                            </Grid>

                            <TextBlock x:Name="LanguageSectionText" Text="语言" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged"
                                      FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="Medium" Style="{StaticResource DarkComboBox}" Margin="0,0,0,18"/>

                            <TextBlock x:Name="AboutSectionText" Text="动态壁纸" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <Border Background="#111A23" BorderBrush="#2C3945" BorderThickness="1" CornerRadius="5" Padding="13" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#20E2231A" BorderBrush="#55E2231A" BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#F06A64"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="AboutTitleText" Text="一张跟随昼夜变化的世界时钟" FontFamily="{StaticResource UiFont}"
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#E3E8ED"/>
                                        <TextBlock x:Name="AboutBodyText" Text="ThinkTime 根据太阳位置绘制晨昏线，并只在夜间区域叠加 NASA Black Marble 城市灯光。壁纸每分钟更新一次，不会遮挡桌面图标或右键菜单。"
                                                   TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Medium" LineHeight="20"
                                                   Foreground="#98A4AF" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TutorialSectionText" Text="快速开始" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="21" Height="21" CornerRadius="11" BorderBrush="#56484B" BorderThickness="1" Background="#1AE2231A" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#F06A64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="Step1TitleText" Text="应用壁纸" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DDE3E8"/>
                                        <TextBlock x:Name="Step1BodyText" Text="点击主界面右上角的红色按钮。" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Medium" Foreground="#87939F"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="21" Height="21" CornerRadius="11" BorderBrush="#394754" BorderThickness="1" Background="#111A23" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#8C98A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="Step2TitleText" Text="保持运行" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DDE3E8"/>
                                        <TextBlock x:Name="Step2BodyText" Text="程序会驻留系统托盘并自动刷新。" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Medium" Foreground="#87939F"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Width="21" Height="21" CornerRadius="11" BorderBrush="#394754" BorderThickness="1" Background="#111A23" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#8C98A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="Step3TitleText" Text="恢复窗口" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#DDE3E8"/>
                                        <TextBlock x:Name="Step3BodyText" Text="双击托盘图标，或使用右键菜单。" FontFamily="{StaticResource UiFont}" FontSize="11.5" FontWeight="Medium" Foreground="#87939F"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="#27323D" Margin="0,0,0,16"/>
                            <TextBlock x:Name="DisplaySectionText" Text="显示与地图" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="Clock24Check" Content="24 小时制" Style="{StaticResource ToggleCheckBox}"
                                      Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,5"/>
                            <CheckBox x:Name="TimeZonesCheck" Content="时区网格" Style="{StaticResource ToggleCheckBox}"
                                      Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,5"/>
                            <CheckBox x:Name="LabelsCheck" Content="城市标签" Style="{StaticResource ToggleCheckBox}"
                                      Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,5"/>
                            <CheckBox x:Name="LowPowerCheck" Content="低功耗更新" Style="{StaticResource ToggleCheckBox}"
                                      Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,18"/>

                            <TextBlock x:Name="AccentCitySectionText" Text="高亮城市" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="AccentCityCombo" SelectionChanged="SettingChanged" FontFamily="{StaticResource UiFont}"
                                      FontSize="12.5" FontWeight="Medium" Style="{StaticResource DarkComboBox}"/>

                            <Border Height="1" Background="#27323D" Margin="0,20,0,14"/>
                            <Grid>
                                <TextBlock x:Name="RefreshIntervalText" Text="壁纸刷新间隔" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="RefreshIntervalValueText" Text="60 秒" HorizontalAlignment="Right" FontFamily="{StaticResource UiFont}"
                                           FontSize="11" FontWeight="Medium" Foreground="#8A96A2"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
